# --- Required ---
OPENAI_API_KEY=sk-...

# --- Local dev: must match the vite proxy target in vite.config.ts (8080) ---
PORT=8080

# --- Optional: Supabase (auth / project storage). Omit to use local token store ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Optional ---
# Deployed server only (NODE_ENV=production): comma-separated accounts that may generate circuits,
# use the AI editor and run the Code tab (DEPLOY.md section 0). Ignored in development.
ALLOWED_EMAILS=

FRONTEND_URL=http://localhost:3000
MOUSER_API_KEY=
TAVILY_API_KEY=
KICAD_CLI_PATH=

# --- Required ---
OPENAI_API_KEY=sk-...

# --- Optional: another OpenAI-compatible provider (server/model.ts). For xAI's Grok:
# OPENAI_API_KEY=<the xAI key>
# OPENAI_BASE_URL=https://api.x.ai/v1
# SF_MODEL=grok-4.3
# SF_MODEL_MINI=grok-4.3
# SF_REASONING_EFFORT=none

# --- Local dev: vite.config.ts reads this for its proxy target ---
PORT=8002

# --- Optional: Supabase (auth / project storage). Omit to use local token store ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Optional ---
# Deployed server only (NODE_ENV=production): comma-separated accounts that may generate circuits,
# use the AI editor and run the Code tab (DEPLOY.md section 0). Ignored in development.
ALLOWED_EMAILS=

FRONTEND_URL=http://localhost:3000
MOUSER_API_KEY=
KICAD_CLI_PATH=

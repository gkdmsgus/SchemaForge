# Secrets never go into an image — set them as deploy variables instead.
.env
.env.*
**/.env
**/.env.*

# Rebuilt inside the image. A build left in any folder too: a stray server/dist went in and was served before the
# image's own (review of 2026-11-07)
node_modules
**/node_modules
dist
**/dist

# Local-only
.git
.claude
.vscode
.idea
**/__pycache__
server/outputs
outputs
*.log
# recordings and benchmark results stay on the machine that made them (GBs of video in a PC build's context)
videos
scripts/bench-results

# Test circuit run artifacts
server/test_circuits/*.net
server/test_circuits/*.erc
server/test_circuits/*_sklib.py
